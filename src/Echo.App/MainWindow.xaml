<Window x:Class="Echo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echo"
        Width="1120" Height="720"
        MinWidth="800" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <!-- WebView2 is created/disposed in code (WebViewController): dispose-on-hide RAM
         strategy + self-healing recreation on renderer/browser process death. -->
    <Grid x:Name="Host" />
</Window>
