<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Echo.Teams</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Echo.Core\Echo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Echo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the annotated example next to the exe so users can copy it to
         teams_selectors.json and edit selectors when a Teams UI update breaks them. -->
    <None Include="teams_selectors.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
