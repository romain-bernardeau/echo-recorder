<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Echo.Core\Echo.Core.csproj" />
    <ProjectReference Include="..\..\src\Echo.Ai\Echo.Ai.csproj" />
    <ProjectReference Include="..\..\src\Echo.Audio\Echo.Audio.csproj" />
    <ProjectReference Include="..\..\src\Echo.Teams\Echo.Teams.csproj" />
    <!-- Engine logic (SessionManager decisions, Updater script, hotkey parsing) lives in the
         WPF exe; internals are exposed through InternalsVisibleTo in Echo.App/AssemblyInfo.cs. -->
    <ProjectReference Include="..\..\src\Echo.App\Echo.App.csproj" />
  </ItemGroup>

</Project>
